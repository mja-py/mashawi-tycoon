; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it is still editable by hand.

config_version=5

[application]

config/name="Mashawi Tycoon"
config/description="A 2.5D Dubai mashawi-stand business sim in the spirit of the classic Lemonade Tycoon."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
boot_splash/bg_color=Color(0.98, 0.91, 0.76, 1)
config/icon="res://icon.svg"
config/quit_on_go_back=false

[autoload]

Data="*res://scripts/core/data.gd"
Loc="*res://scripts/core/loc.gd"
Game="*res://scripts/core/game.gd"
Sfx="*res://scripts/core/sfx.gd"
Icons="*res://scripts/ui/icons.gd"
DevTools="*res://scripts/core/dev_tools.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/stretch/scale=1.25
window/handheld/orientation=4

[gui]

common/snap_controls_to_pixels=false

[internationalization]

locale/translations=PackedStringArray("res://assets/i18n/strings.en.translation", "res://assets/i18n/strings.ar.translation")
locale/fallback="en"

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.web=0
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/directional_shadow/size.web=1024
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.web=0
